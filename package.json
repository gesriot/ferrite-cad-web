    "lightningcss": "^1.28.0",
    "lucide-react": "^0.510.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.0",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.13.0",
    "replicad": "^1.1.0",
    "replicad-opencascadejs": "^1.1.0",
    "sonner": "^2.0.7",
    "sql.js": "^1.13.0",
