{
  "name": "ferrite-cad-web",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build && node scripts/wasm-mime.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'scripts/**/*.test.mjs'",
    "test:fcad": "node --experimental-strip-types --test src/occt/brep.test.ts src/occt/fcad-doc.test.ts src/occt/commit-race.test.ts src/lib/cad/format.test.ts src/occt/fcad-current.test.ts",
    "test:current": "node --experimental-strip-types --test src/occt/fcad-current.test.ts",
    "test:fcad:browser": "node scripts/fcad-browser.mjs",
    "test:xde": "node --experimental-strip-types --test src/xde/fit.test.ts src/occt/fcad-scene.test.ts src/occt/fcad-imported.test.ts src/xde/fcad-extract.test.ts src/xde/client.test.ts && node --experimental-strip-types scripts/xde-node.ts && node --experimental-strip-types scripts/xde-scene.ts",
    "test:xde:browser": "node scripts/xde-browser.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:placement": "node --test src/xde/placement-math/f64.test.mjs",
    "test:contract": "node --experimental-strip-types --test src/occt/current-contract.test.ts src/occt/file-limits.test.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:kernel && npm run test:fcad && npm run test:contract && npm run test:xde && npm run test:placement",
    "test:kernel": "node --experimental-strip-types --test src/lib/cad/kernel.test.ts"
  },
  "dependencies": {
